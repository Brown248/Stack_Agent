{
  "name": "stack-agent",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Claude Code plugin: verification, ratcheting guard rules, hooks, skills, judge, and evals for any project.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "validate": "claude plugin validate . --strict",
    "ab": "node scripts/ab/run.mjs",
    "micro": "node scripts/micro/run.mjs",
    "micro:routing": "node scripts/micro/routing-live.mjs",
    "tune": "node scripts/micro/tune.mjs",
    "sample:guard": "node scripts/guard.mjs --root examples/sample-backend",
    "sample:verify": "node scripts/verify.mjs --root examples/sample-backend",
    "sample:api-map": "node scripts/api-map.mjs --root examples/sample-backend",
    "example:cli": "node scripts/guard.mjs --root examples/sample-cli && node scripts/verify.mjs --root examples/sample-cli"
  },
  "license": "MIT"
}
